# Copie ce fichier en `.env` (jamais commité) puis remplis les valeurs.

# Clé OpenRouter : donne accès à Jev ET aux LLM comparés (une seule clé).
# Création : https://openrouter.ai/settings/keys   —   5 $ de crédit suffisent largement (le banc complet coûte moins d'un centime).
OPENROUTER_API_KEY=

# Voix du robot quand il répond avec des mots (optionnel : sans ces variables, voix française macOS « Thomas »).
ELEVENLABS_API_KEY=
# Exemples de voix de ton compte : cgSgspJ2msm6clMCkdW9 (Jessica, enjouée), FGY2WhTYpPnrIDTdsKH5 (Laura, pétillante)
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# Robot Reachy Mini (connexion réseau). Nom mDNS ou adresse IP, ex. 192.168.1.42
REACHY_HOTE=reachy-mini.local
